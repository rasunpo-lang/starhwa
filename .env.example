# Copy this file to .env.local and fill in real values.
# .env.local is already covered by .gitignore — never commit real secrets.

# Formspree form ID for the "Help the Encyclopedia" contribution form.
# Find it in your Formspree dashboard: it's the part after /f/ in your
# form's endpoint URL, e.g. https://formspree.io/f/abcdwxyz -> abcdwxyz
FORMSPREE_FORM_ID=

# Where the footer's "The Crew's Secret" hourglass links to (the hosted game's
# URL). Leave empty until the game is live: the entrance stays hidden in
# production and shows as a dimmed placeholder in development.
NEXT_PUBLIC_CREWS_SECRET_URL=

# Password for the private /maintenance renewal page (HTTP Basic Auth, any
# username). Leave empty to disable the page entirely (it returns 404).
MAINTENANCE_PASSWORD=

# Renewal dates shown on /maintenance, as YYYY-MM-DD (counted to the start of
# that day in America/Vancouver). Server-only: never prefix with NEXT_PUBLIC_
# and never commit real dates — the repository is public. A missing or
# invalid date leaves that row out. The NAME values are optional labels.
RENEWAL_HOSTING_DATE=
RENEWAL_HOSTING_NAME=
RENEWAL_DOMAIN_DATE=
RENEWAL_DOMAIN_NAME=
